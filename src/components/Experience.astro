---
import { Image } from 'astro:assets';
import { experience, type Company } from '../data/content';
import { formatPeriod, ui, type Lang } from '../i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

function companyPeriod(company: Company): string {
    const starts = company.roles.map((role) => role.start).sort();
    const ends = company.roles.map((role) => role.end);
    const end = ends.includes(null) ? null : (ends as string[]).sort().at(-1)!;
    return formatPeriod(starts[0], end, lang);
}
---

<section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container">
        <div class="section-head">
            <span class="kicker">{t.sections.experience.kicker}</span>
            <h2 id="experience-title" class="section-title">
                {t.sections.experience.title}
            </h2>
        </div>

        <ol class="companies" role="list">
            {experience.map((company) => (
                <li class="company card">
                    <header class="company-head">
                        <Image
                            src={company.logo}
                            alt=""
                            width={48}
                            height={48}
                            densities={[1, 2]}
                            class="company-logo"
                        />
                        <div class="company-info">
                            <h3>
                                <a href={company.url} target="_blank" rel="noopener">
                                    {company.name[lang]}
                                </a>
                            </h3>
                            <p class="context">{company.context[lang]}</p>
                        </div>
                        <p class="company-meta">
                            <span>{companyPeriod(company)}</span>
                            <span>{company.location[lang]}</span>
                        </p>
                    </header>

                    <ol class="roles" role="list">
                        {company.roles.map((role) => (
                            <li class="role">
                                <span class="hex node" aria-hidden="true" />
                                <div class="role-head">
                                    <h4>
                                        {role.title[lang]}
                                        <span class="team">{role.team[lang]}</span>
                                    </h4>
                                    <p class="period">
                                        {role.end === null && (
                                            <span class="badge">{t.current}</span>
                                        )}
                                        {formatPeriod(role.start, role.end, lang)}
                                    </p>
                                </div>
                                <ul class="bullets">
                                    {role.bullets[lang].map((bullet) => (
                                        <li>{bullet}</li>
                                    ))}
                                </ul>
                            </li>
                        ))}
                    </ol>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .companies {
        display: grid;
        gap: 1.25rem;
    }

    .company {
        padding: clamp(1.25rem, 3vw, 2rem);
    }

    .company-head {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem 1rem;
        align-items: start;
    }

    .company-logo {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        object-fit: contain;
        background: #fff;
        border: 1px solid var(--border);
        padding: 4px;
    }

    h3 {
        font-size: 1.25rem;
        font-weight: 700;
    }

    h3 a {
        color: var(--text);
        text-decoration: none;
    }

    h3 a:hover {
        color: var(--accent);
        text-decoration: underline;
    }

    .context {
        color: var(--muted);
        font-size: 0.9375rem;
    }

    .company-meta {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--muted);
    }

    @media (min-width: 720px) {
        .company-head {
            grid-template-columns: auto 1fr auto;
        }

        .company-meta {
            grid-column: auto;
            flex-direction: column;
            align-items: flex-end;
            text-align: right;
        }
    }

    .roles {
        margin-top: 1.5rem;
        margin-left: 7px;
        border-left: 2px solid var(--border);
        display: grid;
        gap: 1.5rem;
    }

    .role {
        position: relative;
        padding-left: 1.25rem;
    }

    @media (min-width: 720px) {
        .roles {
            margin-left: 23px;
        }

        .role {
            padding-left: 1.5rem;
        }
    }

    .node {
        position: absolute;
        left: -8px;
        top: 0.3rem;
        width: 14px;
        aspect-ratio: 0.866;
        background: var(--border);
    }

    .role:first-child .node {
        background: var(--brand);
    }

    .role-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.25rem 1rem;
    }

    h4 {
        font-size: 1rem;
        font-weight: 650;
    }

    .team {
        display: block;
        font-weight: 500;
        font-size: 0.875rem;
        color: var(--muted);
    }

    .period {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--muted);
        white-space: nowrap;
    }

    .badge {
        padding: 0.0625rem 0.5rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: 600;
        font-size: 0.75rem;
    }

    .bullets {
        margin-top: 0.625rem;
        padding-left: 1.1rem;
        display: grid;
        gap: 0.375rem;
        font-size: 0.9375rem;
    }

    .bullets li::marker {
        color: var(--brand);
    }
</style>
