---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/content';
import { homePath, ui } from '../i18n';

const t = ui.pt.notFound;
---

<Base lang="pt" title={`${t.title} | ${profile.name}`} description={t.text} noindex>
    <Header lang="pt" onHome={false} />
    <main id="main-content" class="container not-found">
        <span class="kicker">404</span>
        <h1>{t.title}</h1>
        <p>{t.text}</p>
        <a class="btn btn-primary" href={homePath.pt}>
            {t.back}
        </a>
    </main>
    <Footer lang="pt" />
</Base>

<style>
    .not-found {
        min-height: calc(100vh - var(--header-h) - 80px);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 1rem;
        padding-block: 4rem;
    }

    h1 {
        font-size: clamp(2rem, 5vw, 3rem);
    }

    p {
        color: var(--muted);
    }
</style>
