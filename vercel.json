{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "astro",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/",
            "has": [{ "type": "query", "key": "lang", "value": "en" }],
            "destination": "/en/",
            "permanent": true
        }
    ]
}
