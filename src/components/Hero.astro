---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import me from '../assets/me.jpg';
import { profile } from '../data/content';
import { resumePath, ui, yearsSince, type Lang } from '../i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const years = yearsSince(profile.careerStart);
const photoAlt = lang === 'pt' ? `Foto de ${profile.name}` : `Photo of ${profile.name}`;
---

<section class="hero" aria-labelledby="hero-title">
    <svg class="hex-pattern" aria-hidden="true" focusable="false">
        <defs>
            <pattern
                id="hero-hex"
                width="150"
                height="86.6"
                patternUnits="userSpaceOnUse"
                patternTransform="scale(0.5) rotate(30)"
            >
                <polygon
                    id="hero-hex-poly"
                    points="125,43.3 100,86.6 50,86.6 25,43.3 50,0 100,0"
                ></polygon>
                <use href="#hero-hex-poly" x="75" y="-43.3"></use>
                <use href="#hero-hex-poly" x="75" y="43.3"></use>
                <use href="#hero-hex-poly" x="-75" y="43.3"></use>
                <use href="#hero-hex-poly" x="-75" y="-43.3"></use>
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#hero-hex)"></rect>
    </svg>

    <div class="container hero-grid">
        <div class="hero-text">
            <p class="hero-role">{profile.role[lang]}</p>
            <h1 id="hero-title">{profile.name}</h1>
            <p class="hero-lead">{profile.headline[lang]}</p>

            <ul class="hero-meta" role="list">
                <li>
                    <Icon name="pin" size={16} /> {profile.location[lang]}
                </li>
                <li>
                    <span class="dot" aria-hidden="true"></span> {t.hero.yearsOfExperience(years)}
                </li>
            </ul>

            <div class="hero-cta">
                <a class="btn btn-primary" href="#contact">
                    <Icon name="mail" /> {t.hero.contact}
                </a>
                <a class="btn btn-ghost" href="#projects">
                    {t.hero.projects} <Icon name="arrow" />
                </a>
                <a class="btn btn-ghost" href={resumePath[lang]}>
                    <Icon name="file" /> {t.hero.resume}
                </a>
            </div>

            <div class="hero-social">
                <a
                    class="icon-btn"
                    href={profile.github}
                    rel="me noopener"
                    target="_blank"
                    aria-label="GitHub"
                >
                    <Icon name="github" />
                </a>
                <a
                    class="icon-btn"
                    href={profile.linkedin}
                    rel="me noopener"
                    target="_blank"
                    aria-label="LinkedIn"
                >
                    <Icon name="linkedin" />
                </a>
            </div>
        </div>

        <div class="hero-photo">
            <div class="hex hex-shadow" aria-hidden="true"></div>
            <div class="hex hex-border" aria-hidden="true"></div>
            <Image
                class="hex photo"
                src={me}
                alt={photoAlt}
                widths={[320, 480, 640]}
                sizes="(min-width: 880px) 320px, 240px"
                loading="eager"
                fetchpriority="high"
            />
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        overflow: hidden;
        padding-block: clamp(2.5rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4rem);
    }

    .hex-pattern {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        color: var(--grid);
        fill: none;
        stroke: currentColor;
        stroke-width: 3;
        mask-image: radial-gradient(ellipse 70% 80% at 80% 40%, #000 20%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 70% 80% at 80% 40%, #000 20%, transparent 75%);
        pointer-events: none;
    }

    .hero-grid {
        position: relative;
        display: grid;
        gap: clamp(2.5rem, 6vw, 4rem);
        align-items: center;
    }

    @media (min-width: 880px) {
        .hero-grid {
            grid-template-columns: minmax(0, 1fr) auto;
        }
    }

    .hero-role {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--accent);
        margin-bottom: 0.75rem;
    }

    h1 {
        font-size: clamp(2.5rem, 6vw + 0.5rem, 4.25rem);
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1.05;
    }

    .hero-lead {
        margin-top: 1.25rem;
        max-width: 36rem;
        font-size: clamp(1.0625rem, 0.5vw + 1rem, 1.25rem);
        color: var(--muted);
    }

    .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin-top: 1.25rem;
        font-size: 0.9375rem;
        color: var(--muted);
    }

    .hero-meta li {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--brand);
        box-shadow: 0 0 0 4px var(--accent-soft);
    }

    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .hero-social {
        display: flex;
        gap: 0.5rem;
        margin-top: 1.25rem;
    }

    .hero-photo {
        position: relative;
        justify-self: center;
        width: clamp(200px, 55vw, 300px);
        aspect-ratio: 0.866;
        order: -1;
    }

    @media (min-width: 880px) {
        .hero-photo {
            order: 0;
            width: 320px;
            margin-right: 1.5rem;
        }
    }

    .hex-shadow,
    .hex-border,
    .photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .hex-shadow {
        background: var(--accent-soft);
        transform: translate(18px, 16px);
    }

    .hex-border {
        background: var(--brand);
        transform: scale(1.035);
    }

    .photo {
        object-fit: cover;
        background: var(--surface-2);
    }

    @media (max-width: 479px) {
        .hero-cta .btn {
            flex: 1 1 auto;
        }
    }
</style>
