---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { featuredProjects, otherProjects } from '../data/content';
import { ui, type Lang } from '../i18n';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const shotAlt = (name: string) =>
    lang === 'pt' ? `Captura de tela do ${name}` : `${name} screenshot`;
---

<section id="projects" class="section" aria-labelledby="projects-title">
    <div class="container">
        <div class="section-head">
            <span class="kicker">{t.sections.projects.kicker}</span>
            <h2 id="projects-title" class="section-title">
                {t.sections.projects.title}
            </h2>
            <p class="section-intro">{t.sections.projects.intro}</p>
        </div>

        <div class="featured">
            {featuredProjects.map((project) => (
                <article class="project card">
                    <div class="media">
                        {project.image ? (
                            <Image
                                src={project.image}
                                alt={shotAlt(project.name)}
                                widths={[480, 720, 1040]}
                                sizes="(min-width: 800px) 520px, 100vw"
                                class="shot"
                            />
                        ) : (
                            <div class="terminal" aria-hidden="true">
                                <div class="terminal-bar">
                                    <span />
                                    <span />
                                    <span />
                                    <code>~/{project.repo.split('/').at(-1)}</code>
                                </div>
                                <div class="lines">
                                    <code class="comment"># {project.stack.join(' · ')}</code>
                                    {project.terminal?.map((line) => (
                                        <code>
                                            <span class="prompt">$</span> {line}
                                        </code>
                                    ))}
                                    <code>
                                        <span class="prompt">$</span> <span class="cursor" />
                                    </code>
                                </div>
                            </div>
                        )}
                    </div>

                    <div class="body">
                        <p class="kind">{project.kind[lang]}</p>
                        <h3>{project.name}</h3>
                        <p class="summary">{project.summary[lang]}</p>
                        <ul class="points">
                            {project.highlights[lang].map((point) => (
                                <li>{point}</li>
                            ))}
                        </ul>
                        <ul class="chip-list" aria-label="Stack">
                            {project.stack.map((tech) => (
                                <li class="chip">{tech}</li>
                            ))}
                        </ul>
                        <div class="links">
                            {project.demo && (
                                <a
                                    class="btn btn-primary"
                                    href={project.demo}
                                    target="_blank"
                                    rel="noopener"
                                >
                                    {t.demo} <Icon name="external" />
                                </a>
                            )}
                            <a
                                class="btn btn-ghost"
                                href={project.repo}
                                target="_blank"
                                rel="noopener"
                            >
                                <Icon name="github" /> {t.code}
                            </a>
                        </div>
                    </div>
                </article>
            ))}
        </div>

        <h3 class="others-title">{t.sections.projects.others}</h3>
        <ul class="others" role="list">
            {otherProjects.map((project) => (
                <li class="other">
                    <div class="other-main">
                        <h4>{project.name}</h4>
                        <p>{project.summary[lang]}</p>
                        <ul class="chip-list" aria-label="Stack">
                            {project.stack.map((tech) => (
                                <li class="chip">{tech}</li>
                            ))}
                        </ul>
                    </div>
                    <div class="other-links">
                        {project.demo && (
                            <a
                                class="icon-btn"
                                href={project.demo}
                                target="_blank"
                                rel="noopener"
                                aria-label={`${t.demo}: ${project.name}`}
                            >
                                <Icon name="external" />
                            </a>
                        )}
                        <a
                            class="icon-btn"
                            href={project.repo}
                            target="_blank"
                            rel="noopener"
                            aria-label={`${t.code}: ${project.name}`}
                        >
                            <Icon name="github" />
                        </a>
                    </div>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .featured {
        display: grid;
        gap: 1.25rem;
    }

    @media (min-width: 800px) {
        .featured {
            grid-template-columns: 1fr 1fr;
        }
    }

    .project {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .media {
        aspect-ratio: 16 / 10;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
        overflow: hidden;
    }

    .shot {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top left;
    }

    .terminal {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #111a1d;
        color: #d7e2dd;
        font-family: var(--font-mono);
        font-size: 0.875rem;
    }

    .terminal-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #22303a;
    }

    .terminal-bar span {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #33434b;
    }

    .terminal-bar span:first-child {
        background: var(--brand);
    }

    .terminal-bar code {
        margin-left: 0.5rem;
        color: #8fa29b;
        font-size: 0.75rem;
    }

    .lines {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1.25rem clamp(1rem, 4vw, 2rem);
        font-size: clamp(0.8125rem, 1.2vw + 0.5rem, 0.9375rem);
        line-height: 2;
        background-image: radial-gradient(
            circle at 100% 100%,
            rgba(60, 199, 159, 0.14),
            transparent 55%
        );
    }

    .lines code {
        display: block;
        font-family: inherit;
        white-space: pre-wrap;
    }

    .comment {
        color: #6f8780;
        margin-bottom: 0.25rem;
    }

    .prompt {
        color: #3cc79f;
    }

    .cursor {
        display: inline-block;
        width: 0.6em;
        height: 1.1em;
        vertical-align: text-bottom;
        background: #3cc79f;
    }

    @media (prefers-reduced-motion: no-preference) {
        .cursor {
            animation: blink 1.1s steps(1) infinite;
        }
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }

    .body {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 0.75rem;
        padding: 1.5rem;
    }

    .kind {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent);
    }

    h3 {
        font-size: 1.375rem;
        font-weight: 700;
        margin-top: -0.25rem;
    }

    .summary {
        color: var(--muted);
    }

    .points {
        padding-left: 1.1rem;
        display: grid;
        gap: 0.25rem;
        font-size: 0.9375rem;
    }

    .points li::marker {
        color: var(--brand);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: auto;
        padding-top: 0.5rem;
    }

    .links .btn {
        min-height: 40px;
        font-size: 0.875rem;
        padding-inline: 1rem;
    }

    .others-title {
        margin-top: 3rem;
        margin-bottom: 1rem;
        font-size: 1.125rem;
        font-weight: 650;
    }

    .others {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
    }

    .other {
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        align-items: flex-start;
        padding: 1.25rem 1.5rem;
    }

    .other + .other {
        border-top: 1px solid var(--border);
    }

    .other h4 {
        font-size: 1rem;
        font-weight: 650;
    }

    .other p {
        margin-block: 0.125rem 0.5rem;
        color: var(--muted);
        font-size: 0.9375rem;
    }

    .other-links {
        display: flex;
        gap: 0.5rem;
        flex: none;
    }
</style>
